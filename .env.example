# Public edge URL and host port
PUBLIC_URL=http://localhost
HTTP_PORT=80

# Required secrets. Use long random values; keep database and Redis passwords
# URL-safe because they are embedded in connection URLs by docker-compose.yml.
SECRET_KEY=replace-with-at-least-64-random-characters
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-long-url-safe-password

# PostgreSQL
POSTGRES_DB=icap_db
POSTGRES_USER=icap_user

# Backend cache and authentication
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
RECOMMENDATION_CACHE_TTL_SECONDS=300
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Optional one-time administrator seed. Leave both email and password empty to
# disable seeding; remove the password from .env after the account is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Intelligent Cognitive Alarm
SMTP_USE_TLS=true

# Google OAuth (optional)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

# AI and push delivery (optional)
GEMINI_API_KEY=
FCM_ENABLED=false
# Base64-encoded Firebase service-account JSON; never use a browser Firebase key here.
FIREBASE_CREDENTIALS_JSON=

# Notification scheduler
NOTIFICATION_PROCESSING_INTERVAL_SECONDS=60
NOTIFICATION_RETRY_INTERVAL_SECONDS=300
NOTIFICATION_MAX_PUSH_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=300

# Public Firebase web configuration, embedded in the frontend build
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=