# Public edge URL and host ports. PUBLIC_URL must be the https:// origin the
# browser actually reaches: the edge answers plain HTTP with a 308 to https.
PUBLIC_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Common name on the fallback self-signed certificate the edge generates when
# no CA-issued certificate is mounted over /etc/nginx/tls.
TLS_COMMON_NAME=localhost

# Optional CDN origin for the hashed frontend assets in /static (e.g.
# https://cdn.example.com). Build-time only: it sets the webpack asset prefix
# and is added to the CSP. Leave empty to serve everything same-origin.
CDN_BASE_URL=

# Required secrets. Use long random values; keep database and Redis passwords
# URL-safe because they are embedded in connection URLs by docker-compose.yml.
SECRET_KEY=replace-with-at-least-64-random-characters
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-long-url-safe-password

# PostgreSQL
POSTGRES_DB=icap_db
POSTGRES_USER=icap_user

# Backend cache and authentication
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
RECOMMENDATION_CACHE_TTL_SECONDS=300
# Short-TTL cache for the admin aggregates and the behavioural analytics pass.
# Set the TTL to 0 to disable it.
AGGREGATE_CACHE_ENABLED=true
AGGREGATE_CACHE_TTL_SECONDS=30
# Production refuses to start with a missing/weak SECRET_KEY or insecure cookies.
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Session cookies (HttpOnly + Secure; SPA never stores JWTs in localStorage)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Brute-force / abuse protection
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_SECONDS=900

# Optional one-time administrator seed. Leave both email and password empty to
# disable seeding; remove the password from .env after the account is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Intelligent Cognitive Alarm
SMTP_USE_TLS=true

# Google OAuth (optional)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

# AI and push delivery (optional)
# GEMINI_API_KEY enables AI-generated cognitive challenges; without it the
# deterministic procedural generators are used.
GEMINI_API_KEY=
AI_CHALLENGE_ENABLED=true
AI_CHALLENGE_MODEL=gemini-1.5-flash
AI_CHALLENGE_TIMEOUT_SECONDS=6
AI_CHALLENGE_COOLDOWN_SECONDS=300
FCM_ENABLED=false
# Base64-encoded Firebase service-account JSON; never use a browser Firebase key here.
FIREBASE_CREDENTIALS_JSON=

# Notification scheduler
NOTIFICATION_PROCESSING_INTERVAL_SECONDS=60
NOTIFICATION_RETRY_INTERVAL_SECONDS=300
NOTIFICATION_MAX_PUSH_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=300

# Public Firebase web configuration, embedded in the frontend build
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=
# -- Logging & monitoring ---------------------------------------------
# LOG_FORMAT=json emits one structured record per line for log aggregation;
# use "console" for readable local output.
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_TO_CONSOLE=false silences stdout; the rotating file still records all.
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_ACCESS_ENABLED=true
LOG_SQL_LEVEL=WARNING

# Thresholds evaluated against the measured /system/metrics readings.
METRICS_ALERTS_ENABLED=true
METRICS_ALERT_INTERVAL_SECONDS=60
METRICS_ALERT_P95_MS=400
METRICS_ALERT_ERROR_RATE_PCT=5
# Optional outbound delivery (Alertmanager / Slack / PagerDuty webhook URL).
METRICS_ALERT_WEBHOOK_URL=
# Bearer token letting Prometheus scrape /api/v1/system/metrics/prometheus
# without an admin session. Leave empty to restrict scraping to admins.
METRICS_SCRAPE_TOKEN=
