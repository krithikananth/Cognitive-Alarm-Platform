# ──────────────────────────────────────────────────────────
# Intelligent Cognitive Alarm Platform — Frontend Config
# ──────────────────────────────────────────────────────────
# This app is built with Create React App, so every variable that must reach
# the browser has to be prefixed with REACT_APP_. Values are inlined at build
# time, which means a rebuild is required after changing this file.

# Backend API base URL
REACT_APP_API_URL=http://localhost:8000/api/v1

# ──────────────────────────────────────────────────────────
# Firebase Cloud Messaging (web push)
# ──────────────────────────────────────────────────────────
# Copy these from Firebase console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.
# These are public client identifiers, not secrets, but they still differ per
# environment, so keep the real values in .env / .env.production (git-ignored).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Web Push certificate key pair from
# Firebase console → Project settings → Cloud Messaging → Web configuration.
# Required for getToken() to return an FCM registration token in the browser.
REACT_APP_FIREBASE_VAPID_KEY=
