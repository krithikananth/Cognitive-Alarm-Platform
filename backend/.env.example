# ──────────────────────────────────────────────────────────
# Intelligent Cognitive Alarm Platform — Environment Config
# ──────────────────────────────────────────────────────────

# Project
PROJECT_NAME=Intelligent Cognitive Alarm Platform
VERSION=1.0.0
# development | test | production. Production refuses to start without a
# strong SECRET_KEY and forces Secure auth cookies.
ENVIRONMENT=development

# Security (REQUIRED IN PRODUCTION — at least 32 chars, never a placeholder)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left blank outside production, a constant insecure development key is used.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session cookies (HttpOnly; the SPA never stores JWTs in localStorage)
AUTH_COOKIE_ENABLED=true
ACCESS_COOKIE_NAME=icap_access_token
REFRESH_COOKIE_NAME=icap_refresh_token
# Leave blank to derive from ENVIRONMENT (Secure is mandatory in production).
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Brute-force / abuse protection
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_SECONDS=900

# Database
# SQLite (development)
DATABASE_URL=sqlite:///./icap.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://icap_user:icap_password@localhost:5432/icap_db

# Redis (recommendation cache — optional; app falls back to live compute if down)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
RECOMMENDATION_CACHE_TTL_SECONDS=300
# Short-TTL cache for the admin aggregates and the behavioural analytics pass.
# Set the TTL to 0 to disable it.
AGGREGATE_CACHE_ENABLED=true
AGGREGATE_CACHE_TTL_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Frontend SPA (OAuth + password-reset / email-verification links)
FRONTEND_URL=http://localhost:3000

# Auth token lifetimes (password reset / email verification)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# SMTP (optional — when unset, reset/verify links are logged instead of emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Intelligent Cognitive Alarm
SMTP_USE_TLS=true

# OAuth2 — Google
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match OAUTH2_GOOGLE_REDIRECT_URI exactly.
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Gemini (optional — cognitive challenges and motivational messages fall back
# to deterministic procedural generation / a curated set when unset)
GEMINI_API_KEY=

# AI challenge generation (only used when GEMINI_API_KEY is set)
AI_CHALLENGE_ENABLED=true
AI_CHALLENGE_MODEL=gemini-1.5-flash
# Hard ceiling on a provider call — the ringing alarm is waiting on it.
AI_CHALLENGE_TIMEOUT_SECONDS=6
# After a provider failure, skip AI generation for this long.
AI_CHALLENGE_COOLDOWN_SECONDS=300

# ──────────────────────────────────────────────────────────
# Firebase Cloud Messaging (push notifications)
# ──────────────────────────────────────────────────────────
# Set FCM_ENABLED=true in every environment that should deliver push.
# When it is true, credentials MUST resolve or the app logs an error and
# push delivery is retried — there is no silent "pretend to send" mode.
FCM_ENABLED=true

# Supply credentials with EXACTLY ONE of the two options below.
#
# Option A — file path (local development):
#   Download the service account JSON from
#   Firebase console → Project settings → Service accounts → Generate new private key
#   and place it outside version control (the filename is git-ignored).
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
#
# Option B — inline credentials (containers / PaaS with no writable filesystem).
#   Accepts the raw service-account JSON on one line, or its base64 encoding.
#   Takes precedence over FIREBASE_CREDENTIALS_PATH when both are set.
FIREBASE_CREDENTIALS_JSON=

# Notification queue tuning
# How often the dispatcher drains due notifications (seconds, minimum 15).
NOTIFICATION_PROCESSING_INTERVAL_SECONDS=60
# How often failed pushes are re-attempted (seconds, minimum 30).
NOTIFICATION_RETRY_INTERVAL_SECONDS=300
# Give-up threshold for a single notification's push delivery.
NOTIFICATION_MAX_PUSH_ATTEMPTS=3
# Exponential backoff base between push attempts (seconds).
NOTIFICATION_RETRY_BACKOFF_SECONDS=300

# Server-side alarm dispatch
# Rings due alarms from the backend so a closed browser tab cannot cause a
# missed wake-up. Requires push to be configured above to reach a closed app.
ALARM_DISPATCH_ENABLED=true
# How often armed alarms are swept for a due trigger (seconds, minimum 5).
ALARM_DISPATCH_INTERVAL_SECONDS=20
# Catch-up window after downtime. An alarm later than this is never pushed,
# so a server down overnight does not ring at lunchtime.
ALARM_DISPATCH_MAX_LATENESS_MINUTES=15
# Age at which an unattended alarm advances to its next occurrence (or is
# retired, if one-time). Without this a missed morning parks a daily alarm in
# the past forever.
ALARM_MISSED_ROLLOVER_MINUTES=60

# -- Logging & monitoring ---------------------------------------------
# Without these the root logger has no handler and INFO records are dropped.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE_NAME=icap-backend
# stdout logging; set to false to keep the dev terminal quiet (the rotating
# file still records everything). Ignored when file logging is unavailable.
LOG_TO_CONSOLE=true
# Size-based rotation; degrades to stdout-only if the directory is read-only.
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=icap.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
# One structured access line per request, carrying the correlation id.
LOG_ACCESS_ENABLED=true
LOG_SQL_LEVEL=WARNING
LOG_SCHEDULER_LEVEL=WARNING
REQUEST_ID_HEADER=X-Request-ID

# Alerting over the existing runtime metrics (nothing new is measured).
METRICS_ALERTS_ENABLED=true
METRICS_ALERT_INTERVAL_SECONDS=60
METRICS_ALERT_P95_MS=400
METRICS_ALERT_ERROR_RATE_PCT=5
METRICS_ALERT_MIN_SAMPLES=20
METRICS_ALERT_CRITICAL_MULTIPLIER=2.0
METRICS_ALERT_COOLDOWN_SECONDS=900
METRICS_ALERT_WEBHOOK_URL=
METRICS_SCRAPE_TOKEN=

# Browser error reports posted to POST /api/v1/system/client-errors.
CLIENT_ERROR_LOGGING_ENABLED=true
CLIENT_ERROR_MAX_PER_WINDOW=30
CLIENT_ERROR_WINDOW_SECONDS=60
